generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  novo
  em_analise
  confirmado
  enviado
  cancelado
}

model Industry {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String?
  description String?
  coverImage  String?
  logoImage   String?
  accentColor String    @default("#3b1357")
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active])
  @@index([sortOrder])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  brand          String?
  description    String
  price          Decimal     @db.Decimal(12, 2)
  compareAtPrice Decimal?    @db.Decimal(12, 2)
  unit           String      @default("cx")
  packLabel      String?
  ean            String?
  sku            String?
  imageUrl       String?
  active         Boolean     @default(true)
  featured       Boolean     @default(false)
  industryId     String
  industry       Industry    @relation(fields: [industryId], references: [id])
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@index([industryId])
  @@index([categoryId])
  @@index([active])
  @@index([brand])
}

model Order {
  id           String      @id @default(cuid())
  number       String      @unique
  status       OrderStatus @default(novo)
  customerName String
  company      String?
  city         String
  state        String
  phone        String
  email        String
  notes        String?
  total        Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  unit        String
  quantity    Int
  lineTotal   Decimal  @db.Decimal(12, 2)

  @@index([orderId])
}
